{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd "$CLAUDE_PROJECT_DIR" && git config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "cd "$CLAUDE_PROJECT_DIR" && npm test && npm run build --webpack",
            "timeout": 180,
            "statusMessage": "Running tests and build before push…"
          }
        ]
      }
    ]
  }
}
